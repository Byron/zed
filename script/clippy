#!/usr/bin/env bash

set -euo pipefail

if [[ ! " $* " == *" -p "* && ! " $* " == *" --package "* ]]; then
    set -- "$@" --workspace
fi

if [[ -z "${LK_CUSTOM_WEBRTC:-}" ]]; then
    shopt -s nullglob
    for webrtc_artifact in "$HOME"/.cache/livekit-webrtc/*/*; do
        if [[ -d "$webrtc_artifact/include" \
            && -f "$webrtc_artifact/lib/libwebrtc.a" \
            && -f "$webrtc_artifact/webrtc.ninja" \
            && -f "$webrtc_artifact/desktop_capture.ninja" ]]; then
            export LK_CUSTOM_WEBRTC="$webrtc_artifact"
            echo "Using cached LiveKit WebRTC artifact: $LK_CUSTOM_WEBRTC" >&2
            break
        fi
    done
    shopt -u nullglob
fi

set -x
"${CARGO:-cargo}" clippy "$@" --release --all-targets --all-features -- --deny warnings

# If local, run other checks if we have the tools installed.
if [[ -z "${GITHUB_ACTIONS+x}" ]]; then
    which cargo-shear >/dev/null 2>&1 || exit 0
    cargo shear --locked --deny-warnings

    which typos >/dev/null 2>&1 || exit 0
    typos --config typos.toml

    which buf >/dev/null 2>&1 || exit 0
    buf lint crates/proto/proto
    buf format --diff --exit-code crates/proto/proto
fi
